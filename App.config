<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<add key ="ConnectionString" value="Server=.;Database=GymDB;Integrated Security=True;TrustServerCertificate=True;"/>
	</appSettings>
	<connectionStrings>
		<add name="Gym-SystemDB" connectionString="Server=.;Database=GymDB;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient"/>
	</connectionStrings>
</configuration>